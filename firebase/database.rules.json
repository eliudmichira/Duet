{
  "rules": {
    "rooms": {
      ".read": false,
      ".write": false,
      ".indexOn": ["lastTouch"],

      "$roomId": {
        ".read": "$roomId.length === 6",
        ".write": "$roomId.length === 6 && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && data.child('paired').val() !== true && !root.child('presence/' + $roomId).exists()))",
        ".validate": "newData.hasChildren(['created', 'host'])",

        "state": {
          ".write": "newData.exists() && root.child('rooms/' + $roomId + '/created').exists() && root.child('presence/' + $roomId + '/' + newData.child('updatedBy').val()).exists()",
          ".validate": "newData.hasChildren(['action', 'currentTime', 'updatedBy', 'serverTime'])",

          "action":       { ".validate": "newData.isString() && (newData.val() === 'play' || newData.val() === 'pause')" },
          "currentTime":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 86400" },
          "playbackRate": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 16" },
          "updatedBy":    { ".validate": "newData.isString() && newData.val().length <= 32" },
          "serverTime":   { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())" },
          "force": {
            ".write": "root.child('rooms/' + $roomId + '/created').exists()",
            ".validate": "newData.isBoolean()"
          },
          "$other":       { ".validate": false }
        },

        "meta": {
          "$userId": {
            ".write": "!newData.exists() || (root.child('rooms/' + $roomId + '/created').exists() && root.child('presence/' + $roomId + '/' + $userId).exists())",
            ".validate": "$userId.length <= 32",

            "name":        { ".validate": "newData.isString() && newData.val().length <= 32" },
            "url":         { ".validate": "newData.isString() && newData.val().length <= 1024" },
            "hostname":    { ".validate": "newData.isString() && newData.val().length <= 253" },
            "pageTitle":   { ".validate": "newData.isString() && newData.val().length <= 256" },
            "videoTitle":  { ".validate": "newData.isString() && newData.val().length <= 256" },
            "duration":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 86400" },
            "currentTime": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 86400" },
            "paused":      { ".validate": "newData.isBoolean()" },
            "lastSeen":    { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())" },
            "emoji":       { ".validate": "newData.isString() && newData.val().length <= 16" },
            "$other":      { ".validate": false }
          }
        },

        "reactions": {
          "$reactionId": {
            ".write": "!newData.exists() || (!data.exists() && root.child('rooms/' + $roomId + '/created').exists() && root.child('presence/' + $roomId + '/' + newData.child('from').val()).exists())",
            ".validate": "newData.hasChildren(['emoji', 'from', 'ts'])",
            "emoji": { ".validate": "newData.isString() && newData.val().length <= 140" },
            "from":  { ".validate": "newData.isString() && newData.val().length <= 32" },
            "ts":    { ".validate": "newData.isNumber() && newData.val() === now" },
            "$other": { ".validate": false }
          }
        },

        "together": {
          ".write": "!newData.exists() || root.child('rooms/' + $roomId + '/created').exists()",
          "since": { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())" },
          "total": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$other": { ".validate": false }
        },

        "typing": {
          "$userId": {
            ".write": "!newData.exists() || (root.child('rooms/' + $roomId + '/created').exists() && root.child('presence/' + $roomId + '/' + $userId).exists())",
            ".validate": "$userId.length <= 32 && newData.isBoolean()"
          }
        },

        "ping": {
          "$userId": {
            ".write": "!newData.exists() || (root.child('rooms/' + $roomId + '/created').exists() && root.child('presence/' + $roomId + '/' + $userId).exists())",
            ".validate": "$userId.length <= 32 && newData.isNumber() && newData.val() === now"
          }
        },

        "readycheck": {
          ".write": "!newData.exists() || (root.child('rooms/' + $roomId + '/created').exists() && root.child('presence/' + $roomId + '/' + newData.child('by').val()).exists())",
          ".validate": "newData.hasChildren(['id', 'by', 'at'])",
          "id":    { ".validate": "newData.isString() && newData.val().length <= 16" },
          "by":    { ".validate": "newData.isString() && newData.val().length <= 32" },
          "at":    { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())" },
          "go":    { ".validate": "newData.isNumber()" },
          "time":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 86400" },
          "ready": {
            "$userId": { ".validate": "$userId.length <= 32 && newData.val() === true" }
          },
          "$other": { ".validate": false }
        },

        "paired": {
          ".write": "root.child('rooms/' + $roomId + '/created').exists()",
          ".validate": "newData.val() === true"
        },
        "host":      { ".validate": "newData.isString() && newData.val().length <= 32 && (!data.exists() || newData.val() === data.val())" },
        "created":   { ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || newData.val() === data.val())" },
        "lastTouch": {
          ".write": "root.child('rooms/' + $roomId + '/created').exists()",
          ".validate": "newData.isNumber() && newData.val() === now"
        },

        "$other": { ".validate": false }
      }
    },

    "presence": {
      ".read": false,
      ".write": false,
      "$roomId": {
        ".read": "$roomId.length === 6",
        "$userId": {
          ".write": "$roomId.length === 6 && (!newData.exists() || root.child('rooms/' + $roomId + '/created').exists())",
          ".validate": "$userId.length <= 32 && newData.hasChildren(['joined'])",
          "joined": { ".validate": "newData.isNumber() && newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
